# Per-task JSON histories and checkpoints are reproducible local artifacts.
results/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# Never publish numerical datasets, model weights, optimizer states or solver
# scratch files, even if copied outside the standard artifact tree.
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.h5
*.hdf5
*.zarr/
wandb/

# The parent FNOtest ignores every directory named data/. Re-include this
# project's Python source package while keeping generated artifact data ignored.
!blrpng/data/
!blrpng/data/*.py
